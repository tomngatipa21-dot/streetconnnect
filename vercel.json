{
  "version": 2,
  "headers": [
    {
      "source": "/(index|signup|admin)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/(.*\\.(?:js|css))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
